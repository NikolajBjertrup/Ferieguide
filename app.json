{
  "expo": {
    "name": "FerieGuide",
    "slug": "ferieguide",
    "scheme": "ferieguide",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "FerieGuide bruger mikrofonen, når du indtaler indholdet til din husguide."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FerieGuide bruger kameraet, når du tager billeder til din husguide.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FerieGuide bruger dine billeder, når du vælger billeder til din husguide."
        }
      ],
      "expo-asset"
    ]
  }
}
